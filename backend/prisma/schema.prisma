// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Newsletter {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  createdAt DateTime @default(now())

  @@map("newsletter")
}

model User {
  id              BigInt    @id @default(autoincrement())
  name            String
  firstname       String
  email           String    @unique
  password        String?
  role            UserRole  @default(USER)
  verifiedAt      DateTime? @map("verified_at")
  validationToken String?   @map("validation_token")

  googleId    String?   @unique
  avatar      String?

  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  orders Order[]
  wishlists Wishlist[]
  addresses Address[]
  reviews Review[]

  @@map("users")
}

enum UserRole {
  USER
  ADMIN
}

model Blog {
  id          Int      @id @default(autoincrement())
  title       String
  slug        String   @unique
  metaDescription String?
  keywords    String?
  content     String
  picture     String?
  isActivated Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categoryId  Int
  category    Category @relation(fields: [categoryId], references: [id])

  @@map("blogs")
}

model Category {
  id    Int    @id @default(autoincrement())
  name  String

  blogs Blog[]

  @@map("categories")
}

model Contact {
  id              BigInt    @id @default(autoincrement())
  name            String
  email           String    
  content         String  

  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("contacts")

}

enum ProductType {
  BOARD
  MODULE
  SET_PREDEFINED
}

enum Size {
  S
  M
  L
}

model Product {
  id           Int              @id @default(autoincrement())
  name         String
  description  String?
  productType  ProductType
  ageMin       Int
  ageMax       Int
  isActivated  Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  reviews Review[]
  variants     ProductVariant[]
  images       ProductImage[]
  skills       ProductSkill[]
  @@map("products")
}

model ProductVariant {
  id            Int        @id @default(autoincrement())
  productId     Int
  size          Size
  price         Decimal
  stock         Int
  holesCount    Int?
  holesRequired Int?
  product       Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  setVariantItems  SetItem[] @relation("SetVariantItems")
  setProductItems  SetItem[] @relation("SetProductItems")
  orderVariants OrderVariant[]
  wishlists Wishlist[] @relation("WishVariants")

  @@unique([productId, size])
  @@map("product_variants")
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int
  url       String
  position  Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, position])
  @@map("product_images")
}

model Skill {
  id       Int            @id @default(autoincrement())
  label    String @unique
  products ProductSkill[]

  @@map("skills")
}

model ProductSkill {
  productId Int
  skillId   Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  skill     Skill   @relation(fields: [skillId], references: [id])

  @@id([productId, skillId])
  @@map("product_skills")
}

model SetItem {
  id               Int            @id @default(autoincrement())
  setVariantId     Int            
  productVariantId Int
  quantity         Int
  setVariant       ProductVariant @relation("SetVariantItems", fields: [setVariantId], references: [id])
  productVariant   ProductVariant @relation("SetProductItems", fields: [productVariantId], references: [id])

  @@unique([setVariantId, productVariantId])
  @@map("set_items")
}



model Order {
  id                 Int         @id @default(autoincrement())
  userId             BigInt
  trackingNumber     String?
  orderStatus        OrderStatus @default(CART)
  totalAmount        Decimal
  customerFirstname  String?
  customerLastname   String?
  customerEmail      String?

  // Adresse figée au moment de la commande
  customerStreet     String?
  customerCity       String?
  customerPostalCode String?
  customerCountry    String?      @default("France")

  // Point relais si applicable
  customerRelayPointId String?
  customerRelayName    String?

  // Référence vers l'adresse choisie
  addressId          Int?
  address            Address?    @relation(fields: [addressId], references: [id])

  orderDate          DateTime    @default(now())
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  user               User        @relation(fields: [userId], references: [id])
  payment            Payment? 
  promoCodeId    Int?
  discountAmount Decimal?  @default(0)
  promoCode      PromoCode? @relation(fields: [promoCodeId], references: [id])     
  orderVariants OrderVariant[]

  @@map("orders")
}


enum OrderStatus {
  CART
  PENDING
  PAID
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}



model Wishlist {
  id        Int            @id @default(autoincrement())
  userId    BigInt
  createdAt DateTime       @default(now())
  user      User           @relation(fields: [userId], references: [id])
  variants  ProductVariant[] @relation("WishVariants")

  @@map("wishlists")
}



enum AddressType {
  SHIPPING
  BILLING
  RELAY_POINT
}

model Address {
  id           Int         @id @default(autoincrement())
  userId       BigInt
  street       String?
  city         String
  postalCode   String
  country      String      @default("France")
  addressType  AddressType @default(SHIPPING)
  relayPointId String?
  relayName    String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  user         User        @relation(fields: [userId], references: [id])

  orders Order[]

  @@map("addresses")
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model Review {
  id          Int          @id @default(autoincrement())
  userId      BigInt
  productId   Int
  note        Int
  description String
  status      ReviewStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        User         @relation(fields: [userId], references: [id])
  product     Product      @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
  @@map("reviews")
}

model Payment {
  id              Int       @id @default(autoincrement())
  orderId         Int       @unique
  stripeSessionId String
  stripePaymentId String?
  amount          Decimal
  currency        String    @default("eur")
  status          String    @default("PENDING")
  paidAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  order           Order     @relation(fields: [orderId], references: [id])

  @@map("payments")
}

model OrderVariant {
  orderId          Int
  productVariantId Int
  quantity         Int            @default(1)
  order            Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])

  @@id([orderId, productVariantId])
  @@map("order_variants")
}

model PromoCode {
  id            Int      @id @default(autoincrement())
  code          String   @unique
  discountValue Decimal
  discountType  DiscountType @default(PERCENTAGE)
  minAmount     Decimal? 
  maxUses       Int?     
  currentUses   Int      @default(0)
  expiresAt     DateTime?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orders Order[]

  @@map("promo_codes")
}

enum DiscountType {
  PERCENTAGE  // ex: 10% de réduction
  FIXED       // ex: 10€ de réduction
}